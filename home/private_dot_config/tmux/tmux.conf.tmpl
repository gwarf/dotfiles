############ Key Bindings ############

# Prefix
# C-Space is the prefix; C-b stays live as the secondary one so old muscle
# memory keeps working. prefix+C-Space sends a literal C-Space through to the
# app underneath (nested tmux, emacs set-mark, IME toggles).
set -g prefix C-Space
# XXX: disable legacy prefix to retrain muscle memory
# set -g prefix2 C-b
bind-key C-Space send-prefix
bind -N "Send prefix" C-Space send-prefix

# Vi mode for copy
set -g status-keys vi
setw -g mode-keys vi
bind -N "Begin selection" -T copy-mode-vi v send -X begin-selection
bind -N "Copy selection" -T copy-mode-vi y send -X copy-selection-and-cancel

# Toggle between the two most-recent windows (default prefix+l is taken by tmux-pain-control)
bind-key Tab last-window

# General
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",*:RGB"
set  -g base-index 1
setw -g pane-base-index 1
# automatically renumber tmux windows
set -g renumber-windows on
# Disable automatic changes of titles
set -g set-titles on
set -g set-titles-string '#h:#W'
set-window-option -g automatic-rename on
set-window-option -g allow-rename on
set  -g mouse off

set -ag terminal-features "xterm-kitty:extkeys"
set -as terminal-features ",*:clipboard"
# option for terminal colors
# set -sa terminal-features ",xterm-kitty:RGB"
# Enable OSC 8 hyperlinks
set -sa terminal-features ",*:hyperlinks"

set -g history-limit 50000
set -sg escape-time 10
set -g focus-events on
set -g set-clipboard on
# Also needed by yazi image preview: https://yazi-rs.github.io/docs/image-preview/#tmux
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM
setw -g aggressive-resize on
set -g detach-on-destroy off
set -g extended-keys on
%if #{>=:#{version},3.5}
set -g extended-keys-format csi-u
%endif

# Activity Monitoring
setw -g monitor-activity off
set -g visual-activity off

# Without this, panes fall back to the passwd shell (bash) and lose the fish
# config: starship prompt, abbreviations, PATH additions. default-command stays
# unset so tmux runs this as a login shell rather than through a bash wrapper.
{{ if eq .chezmoi.os "freebsd" -}}
set -g default-shell /usr/local/bin/fish
{{ else if eq .chezmoi.os "darwin" -}}
{{ if stat "/opt/homebrew/bin/fish" -}}
set -g default-shell /opt/homebrew/bin/fish
{{ else -}}
set -g default-shell /usr/local/bin/fish
{{ end -}}
{{ else -}}
set -g default-shell /usr/bin/fish
{{ end }}
# Config and help
bind -N "Reload configuration" q source-file ~/.config/tmux/tmux.conf \; display "Configuration reloaded"
{{ if stat "/usr/share/omarchy" -}}
bind -N "Show Tmux keybindings" ? display-popup -E -w 80% -h 70% -T "Tmux keybindings" "omarchy-menu-tmux-keybindings --print | less -R"
{{ else -}}
bind -N "Show Tmux keybindings" ? display-popup -E -w 80% -h 70% -T "Tmux keybindings" "tmux list-keys -N | less"
{{ end }}
# Pane Controls
# Omarchy binds this to kill-pane. No prefix and no confirmation, one slip from
# Alt+Tab, and it took a root shell with it. Prefix+x still kills a pane.
unbind -n M-Escape
bind -N "Kill pane" x kill-pane
bind -N "Synchronize panes" y setw synchronize-panes
bind -N "Send pane to window" s command-prompt -p "send pane to:" "join-pane -t '%%'"

bind -N "Resize pane left" -n C-M-S-Left resize-pane -L 5
bind -N "Resize pane down" -n C-M-S-Down resize-pane -D 5
bind -N "Resize pane up" -n C-M-S-Up resize-pane -U 5
bind -N "Resize pane right" -n C-M-S-Right resize-pane -R 5

# Window navigation
bind -N "Rename window" r command-prompt -I "#W" "rename-window -- '%%'"
bind -N "Create window" c new-window -c "#{pane_current_path}"
bind -N "Swap window with" m command-prompt -p "move window to:" "swap-window -t '%%'"
bind -N "Move window to index" . command-prompt "move-window -r -t '%%'"

bind -N "Switch to window 1" -n M-1 select-window -t 1
bind -N "Switch to window 2" -n M-2 select-window -t 2
bind -N "Switch to window 3" -n M-3 select-window -t 3
bind -N "Switch to window 4" -n M-4 select-window -t 4
bind -N "Switch to window 5" -n M-5 select-window -t 5
bind -N "Switch to window 6" -n M-6 select-window -t 6
bind -N "Switch to window 7" -n M-7 select-window -t 7
bind -N "Switch to window 8" -n M-8 select-window -t 8
bind -N "Switch to window 9" -n M-9 select-window -t 9

bind -N "Previous window" -n M-Left select-window -t -1
bind -N "Next window" -n M-Right select-window -t +1
bind -N "Move window left" -n M-S-Left swap-window -t -1 \; select-window -t -1
bind -N "Move window right" -n M-S-Right swap-window -t +1 \; select-window -t +1

# Session controls
bind -N "Rename session" R command-prompt -I "#S" "rename-session -- '%%'"
bind -N "Create session" C new-session -c "#{pane_current_path}"
bind -N "Previous session" P switch-client -p
bind -N "Next session" N switch-client -n

bind -N "Previous session" -n M-Up switch-client -p
bind -N "Next session" -n M-Down switch-client -n

# ── herdr parity (keep tmux and herdr muscle memory aligned) ──
# Split right on prefix+v (herdr split_vertical); | and % already split right too.
# bind-key v split-window -h -c "#{pane_current_path}"
# prefix+g left at its tmux 3.8 default (floating-pane positioning table);
# the tmux-fzf pane picker that used to live here was unused (2026-08-20).
# find-window kept reachable on C-f since prefix+f now launches tmux-fzf.
bind-key C-f command-prompt { find-window -Z "%%" }

# Day-plan overlay: popup with today's daily note (05:00 Dream.ts writes the
# Overnight brief into it). prefix+t shows, q hides. Replaces clock-mode.
# -EE, not -E: the popup then survives a non-zero exit, so a missing note or
# renderer shows its reason instead of flashing shut with nothing on screen.
bind-key t display-popup -EE -w 82% -h 85% '~/.local/bin/daynote'
bind-key T display-popup -EE -w 82% -h 85% '~/.local/bin/daynote --edit'

############ Theme ############

set -g @catppuccin_flavor "macchiato"
set -g @catppuccin_window_status_style "rounded"
# Run catppuccin here rather than from tpm at the bottom: the status line below
# reads its @catppuccin_status_* and @thm_* options, which only exist once it ran.
if "test -f ~/.config/tmux/plugins/tmux/catppuccin.tmux" \
   "run ~/.config/tmux/plugins/tmux/catppuccin.tmux"

set -g status-position top
set -g status-interval 5
set -g status-left-length 100
set -g status-right-length 100
set -g window-status-separator ""
# Session pill: name on green (red while prefix is held), flat at
# the screen edge and rounded towards the windows.
set -g @session_pill_color "#{?client_prefix,#{@thm_red},#{@thm_green}}"
set -g status-left "#[fg=#{@thm_crust},bg=#{E:@session_pill_color}] #S #[fg=#{E:@session_pill_color},bg=default]\uE0B4 "
set -g status-right "#[fg=#{@thm_blue},bold]#{?pane_in_mode,COPY ,}#{?client_prefix,PREFIX ,}#{?window_zoomed_flag,ZOOM ,}#[default]"
set -ag status-right "#{mpd_now_playing}"
set -agF status-right "#{E:@catppuccin_status_cpu}"
set -ag status-right "#{E:@catppuccin_status_host}"

############ Plugins ############

set -g @plugin "tmux-plugins/tpm"
set -g @plugin "tmux-plugins/tmux-sensible"
set -g @plugin "catppuccin/tmux#v2.1.3"
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin "tmux-plugins/tmux-resurrect"
set -g @plugin "tmux-plugins/tmux-continuum"
set -g @plugin 'timvw/tmux-assistant-resurrect'
# Supplies prefix+| and prefix+- splits plus hjkl pane navigation; the herdr
# parity bindings above assume they exist.
set -g @plugin "tmux-plugins/tmux-pain-control"
set -g @plugin "tmux-plugins/tmux-cpu"
# XXX: would need to hide it when plugged
# https://github.com/tmux-plugins/tmux-battery#enabled
# set -g @plugin "tmux-plugins/tmux-battery"
set -g @plugin "tmux-plugins/tmux-yank"
set -g @plugin "tmux-plugins/tmux-prefix-highlight"
set -g @plugin "tmux-plugins/tmux-logging"
set -g @plugin "alberti42/tmux-fzf-links"
# MPD playing
set -g @plugin "vascomfnunes/tmux-ludanta"

# Automatically restore tmux session
set -g @continuum-restore "on"
# Do not capture panes content to avoid capturing secrets
set -g @resurrect-capture-pane-contents 'off'

# tmux-fzf-links
# python3, not an absolute path: /usr/bin/python is absent on Ubuntu. The editor
# command is set because the plugin's fallback is a hardcoded `open`, absent here.
set-option -g @fzf-links-key C-u
set-option -g @fzf-links-python "python3"
set-option -g @fzf-links-browser-open-cmd "xdg-open '%url'"
set-option -g @fzf-links-editor-open-cmd "tmux new-window -n nvim nvim +%line '%file'"

# tmux-fzf
# prefix+f (shadows default find-window, unused); was C-f until 2026-08-20.
TMUX_FZF_LAUNCH_KEY="f"
# Show the pane title (descriptive, set by Claude Code) in the window list, like choose-tree
set-environment -g TMUX_FZF_WINDOW_FORMAT '#{pane_title}  ·  #{window_name} (#{window_panes}p)'
# Wider/taller popup so titles are not truncated
set-environment -g TMUX_FZF_OPTIONS '-p -w 90% -h 60% -m'

# Install tpm if not available
if "test ! -d ~/.tmux/plugins/tpm" \
   "run 'git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm && ~/.tmux/plugins/tpm/bin/install_plugins'"

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run "~/.tmux/plugins/tpm/tpm"

# Source local configuration if any
if "[ -f ~/.tmux.local.conf ]" "run ~/.tmux.local.conf"
