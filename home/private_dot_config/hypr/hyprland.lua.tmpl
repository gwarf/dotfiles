{{ if stat "/usr/share/omarchy" -}}
-- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/

-- Omarchy's bootstrap keeps path setup out of this user config.
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")

-- Disable all Omarchy default bindings. Add your own in hypr/bindings.lua.
-- omarchy_default_bindings = false
--
-- Or disable only bindings for Omarchy's preinstalled apps/web apps while
-- keeping core window-manager bindings:
-- omarchy_preinstalled_bindings = false

-- Load Omarchy defaults.
require("default.hypr.omarchy")

-- Put your personal overrides in these files. They're loaded after Omarchy's
-- defaults so package updates can improve the defaults without rewriting your
-- ~/.config/hypr files.
require("hypr.monitors")
require("hypr.input")
require("hypr.bindings")
require("hypr.looknfeel")
require("hypr.autostart")

-- Toggle config flags dynamically.
require("default.hypr.toggles")

-- Add any other personal Hyprland configuration below.
-- o.window("qemu", { workspace = "5" })

-- Autostarted apps and their workspace homes live in hypr/autostart.lua.
{{ else -}}
-- Self-owned Hyprland configuration. Wiki: https://wiki.hypr.land/Configuring/Start/

local mocha = require("mocha")

------------------
---- MONITORS ----
------------------
{{ if eq .chezmoi.hostname "sikaru" -}}
-- 3440x1440 only divides cleanly by 1.25, 1.6 and 2.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.25 })
-- The compositor already scales: GTK must not scale again, Qt text follows at 120 DPI.
hl.env("GDK_SCALE", "1")
hl.env("QT_FONT_DPI", "120")
{{ else -}}
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
{{ end -}}

-------------------
---- AUTOSTART ----
-------------------
{{ if eq .chezmoi.osRelease.id "freebsd" -}}
hl.env("SSH_AUTH_SOCK", (os.getenv("XDG_RUNTIME_DIR") or "") .. "/gcr/ssh")
hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --all")
    hl.exec_cmd("/usr/local/libexec/polkit-gnome-authentication-agent-1")
    hl.exec_cmd("/usr/local/libexec/xdg-desktop-portal-hyprland")
    hl.exec_cmd("gnome-keyring-daemon --start --components=secrets,pkcs11,ssh")
    hl.exec_cmd("hypridle")
    hl.exec_cmd("waybar")
    hl.exec_cmd("swaync")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
    hl.exec_cmd("ghostty")
end)
{{ else -}}
-- uwsm app runs each process in its own systemd scope inside the session.
local function app(cmd) return "uwsm app -- " .. cmd end

hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --systemd --all")
    for _, cmd in ipairs({
        "waybar", "swaync", "hyprpaper", "hypridle",
        "wl-paste --type text --watch cliphist store",
        "wl-paste --type image --watch cliphist store",
        "udiskie --automount --no-notify --no-tray",
    }) do hl.exec_cmd(app(cmd)) end
{{- if eq .chezmoi.hostname "sikaru" }}
    -- Two terminals land on workspace 1, where the session starts focused.
    for _, cmd in ipairs({
        "ghostty", "ghostty", "thunderbird", "firefox", "Telegram",
        "element-desktop", "signal-desktop", "obsidian",
    }) do hl.exec_cmd(app(cmd)) end
{{- end }}
end)
{{ end }}
-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------
hl.env("XCURSOR_THEME", "breeze_cursors")
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_THEME", "rose-pine-hyprcursor")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("GDK_BACKEND", "wayland,x11,*")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "wayland")
hl.env("MOZ_ENABLE_WAYLAND", "1")

-----------------------
---- LOOK AND FEEL ----
-----------------------
hl.config({
    general = {
        gaps_in     = 5,
        gaps_out    = 20,
        border_size = 2,
        col = {
            active_border   = { colors = { mocha.mauve, mocha.flamingo }, angle = 90 },
            inactive_border = mocha.subtext0,
        },
        resize_on_border = false,
        allow_tearing    = false,
        layout           = "dwindle",
    },

    decoration = {
        rounding         = 10,
        active_opacity   = 1.0,
        inactive_opacity = 1.0,
{{- if eq .chezmoi.osRelease.id "debian" }}
        shadow = {
            enabled      = true,
            range        = 4,
            render_power = 3,
            color        = 0xee1a1a1a,
        },
{{- end }}
        blur = {
            enabled  = true,
            size     = 3,
            passes   = 1,
            vibrancy = 0.1696,
        },
    },

    animations = {
        enabled = true,
    },

    dwindle = {
        preserve_split = true,
    },

    master = {
        new_status = "master",
    },

    misc = {
        force_default_wallpaper = -1,
        disable_hyprland_logo   = false,
        focus_on_activate       = true,
    },

    input = {
        -- QWERTY-Lafayette. The `custom` symbols file comes from the
        -- qwerty-lafayette package, which is therefore a hard requirement.
        kb_layout    = "custom",
        kb_variant   = "",
        -- kb_model deliberately unset: the xkb rules map model to geometry only,
        -- never to symbols, so it cannot change key behaviour.
        kb_options   = "compose:rctrl",
        kb_rules     = "",
        follow_mouse = 1,
        sensitivity  = 0,
        touchpad = {
            natural_scroll = false,
        },
    },

    debug = {
        disable_logs       = false,
        enable_stdout_logs = true,
    },
})

hl.curve("myBezier", { type = "bezier", points = { {0.05, 0.9}, {0.1, 1.05} } })
hl.animation({ leaf = "windows",     enabled = true, speed = 7,  bezier = "myBezier" })
hl.animation({ leaf = "windowsOut",  enabled = true, speed = 7,  bezier = "default", style = "popin 80%" })
hl.animation({ leaf = "border",      enabled = true, speed = 10, bezier = "default" })
hl.animation({ leaf = "borderangle", enabled = true, speed = 8,  bezier = "default" })
hl.animation({ leaf = "fade",        enabled = true, speed = 7,  bezier = "default" })
hl.animation({ leaf = "workspaces",  enabled = true, speed = 6,  bezier = "default" })

hl.device({
    name        = "epic-mouse-v1",
    sensitivity = -0.5,
})

---------------------
---- KEYBINDINGS ----
---------------------
-- One table drives both the binds and the SUPER+K menu (hypr/binds.lua).
require("binds")

--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------
hl.window_rule({
    name           = "suppress-maximize-events",
    match          = { class = ".*" },
    suppress_event = "maximize",
})
-- Empty XWayland helper windows (drag icons, tooltips) must not steal focus.
hl.window_rule({
    name     = "xwayland-ghosts",
    match    = { class = "^$", title = "^$", xwayland = true },
    float    = true,
    no_focus = true,
})
{{- if eq .chezmoi.hostname "sikaru" }}
-- Class rules, not exec rules: uwsm app detaches the process, so PID-matched
-- rules would miss the window. They apply to every launch, not just login.
for _, home in ipairs({
    { "^org\\.mozilla\\.Thunderbird$", "2" },
    { "^firefox$", "2" },
    { "^(org\\.telegram\\.desktop|TelegramDesktop)$", "3" },
    { "^(Element|element)$", "3" },
    { "^signal$", "3" },
    { "^md\\.obsidian\\.Obsidian$", "4" },
    -- Daryl's Interceptor browser (brave-interceptor.service) stays out of the way.
    { "^brave-origin$", "5" },
}) do
    hl.window_rule({
        name      = "home-" .. home[2] .. "-" .. home[1],
        match     = { class = home[1] },
        workspace = home[2] .. " silent",
    })
end
{{- end }}
{{ end -}}
