[Unit]
Description=PAI statusline cache refresh (location, weather, quote, usage, learning, startup estimate, git age)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.claude
# User units get a minimal PATH and bun lives in a different place per host (installer, mise, distro package).
Environment=PATH=%h/.bun/bin:%h/.local/share/mise/installs/bun/latest/bin:%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun %h/.claude/PAI/STATUSLINE/Refresh.ts
TimeoutStartSec=55s
Nice=10
StandardOutput=journal
StandardError=journal
