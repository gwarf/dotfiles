[Unit]
Description=PAI work sweep (session catch-up, stale flags, work digest)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.claude
# User units get a minimal PATH and bun lives in a different place per host (installer, mise, distro package).
Environment=PATH=%h/.bun/bin:%h/.local/share/mise/installs/bun/latest/bin:%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The Forgejo token arrives as $CREDENTIALS_DIRECTORY/FORGE_TOKEN; without it the sweep disables itself.
LoadCredentialEncrypted=FORGE_TOKEN:%h/.config/credstore.encrypted/FORGE_TOKEN.cred
ExecStart=/usr/bin/env bun %h/.claude/PAI/TOOLS/WorkSweep.ts
TimeoutStartSec=120s
Nice=10
StandardOutput=journal
StandardError=journal
