# Empty values reset the configuration to the default value
# Font
#font-family = "JetBrainsMono Nerd Font"
#font-style = Regular
# ghostty +list-fonts
font-family = "Monaspace Neon"
font-size = 15

# ghostty +list-themes
theme = TokyoNight Moon

# XXX: not yet released
# https://github.com/ghostty-org/ghostty/pull/9335
# selection-word-chars = " \t'\"│`|:;,()[]{}<>$"

{{ if eq .chezmoi.os "darwin" -}}
command = /opt/homebrew/bin/fish --login --interactive
{{ else if eq .chezmoi.os "linux" -}}
command = /usr/bin/fish --login --interactive
{{ end -}}

window-decoration = client

# tmux/herdr-style keys for native tabs/splits (zmx trial: Ghostty owns windowing).
# Leader is ctrl+shift+b — NOT ctrl+b, which must pass through to herdr/tmux
# running inside Ghostty. Same suffixes as the herdr/tmux muscle memory.
keybind = ctrl+shift+b>c=new_tab
keybind = ctrl+shift+b>n=next_tab
keybind = ctrl+shift+b>p=previous_tab
keybind = ctrl+shift+b>comma=prompt_tab_title
keybind = ctrl+shift+b>v=new_split:right
keybind = ctrl+shift+b>minus=new_split:down
keybind = ctrl+shift+b>h=goto_split:left
keybind = ctrl+shift+b>j=goto_split:down
keybind = ctrl+shift+b>k=goto_split:up
keybind = ctrl+shift+b>l=goto_split:right
keybind = ctrl+shift+b>z=toggle_split_zoom
keybind = ctrl+shift+b>x=close_surface

{{ if stat "/usr/share/omarchy" -}}
# Omarchy defaults, verbatim from /usr/share/omarchy/config/ghostty/config.
# Last block wins in Ghostty, so any key repeated above is overridden here.

# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
{{ end -}}
