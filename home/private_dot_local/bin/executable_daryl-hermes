#!/bin/sh
# daryl-hermes — Daryl on the Hermes runtime, via your own Anthropic subscription.
# Usage: daryl-hermes [dir]
# Defaults to claude-sonnet-5. Override:  HERMES_MODEL=claude-opus-5 daryl-hermes
#
# Claude always routes through Anthropic directly, never through Copilot.
set -eu
# shellcheck source=/dev/null
if [ -r "$HOME/.config/daryl/mail-env.sh" ]; then . "$HOME/.config/daryl/mail-env.sh"; fi
MODEL="${HERMES_MODEL:-claude-sonnet-5}"
exec hermes-daryl "${1:-$PWD}" anthropic "$MODEL"
