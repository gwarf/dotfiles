#!/usr/bin/env bash
# Pinentry for rbw: answers rbw-agent's unlock prompt from a TPM-sealed copy of
# the master password (systemd-creds --user, sealed once by hand). Any other
# prompt, a retry after a wrong password or an unreadable credential goes to the
# real pinentry, so a stale seal can never loop into an account lockout.
set -u
cred=${PINENTRY_RBW_CRED:-$HOME/.config/credstore.user/rbw-master.cred}
fallback=${PINENTRY_RBW_FALLBACK:-/usr/bin/pinentry-qt}

# rbw writes every command, then closes stdin before reading any reply.
lines=() prompt='' desc='' retry=''
while IFS= read -r line || [[ -n $line ]]; do
  lines+=("$line")
  case $line in
    'SETPROMPT '*) prompt=${line#SETPROMPT } ;;
    'SETDESC '*) desc=${line#SETDESC } ;;
    'SETERROR '*) retry=1 ;;
  esac
done

if [[ $prompt == 'Master Password' && $desc == 'Unlock the local database'* && -z $retry && -r $cred ]] &&
  pw=$(systemd-creds decrypt --user --name=rbw-master "$cred" -) && [[ -n $pw ]]; then
  pw=${pw//%/%25}
  pw=${pw//$'\r'/%0D}
  pw=${pw//$'\n'/%0A}
  printf 'OK Pleased to meet you\n'
  for line in "${lines[@]}"; do
    if [[ $line == GETPIN ]]; then
      printf 'D %s\nOK\n' "$pw"
    else
      printf 'OK\n'
    fi
  done
  exit 0
fi

exec "$fallback" "$@" < <(printf '%s\n' "${lines[@]}")
