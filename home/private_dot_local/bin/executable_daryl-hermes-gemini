#!/bin/sh
# daryl-hermes-gemini — Daryl on the Hermes runtime, Google Gemini via your own API key.
# Usage: daryl-hermes-gemini [dir]
# Defaults to gemini-2.5-flash. Override:  HERMES_MODEL=gemini-2.5-pro daryl-hermes-gemini
#
# Uses GEMINI_API_KEY from the credstore, so this is the one non-Anthropic
# route that touches neither the Max seat nor the OPERAS Copilot seat.
set -eu
# shellcheck source=/dev/null
if [ -r "$HOME/.config/daryl/mail-env.sh" ]; then . "$HOME/.config/daryl/mail-env.sh"; fi
MODEL="${HERMES_MODEL:-gemini-2.5-flash}"
exec hermes-daryl "${1:-$PWD}" gemini "$MODEL"
