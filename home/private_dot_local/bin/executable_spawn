#!/bin/sh
# spawn — open a tmux window running an agent CLI, seeded with a prompt.
# daryl (a symlink to this script) runs the same thing in the current pane.
# Thin wrapper over the PAI _SPAWN tool; spawn switches to the new window unless -d.
set -e
tool="$HOME/.claude/skills/_SPAWN/Tools/SpawnSession.ts"
self=$(basename "$0")

usage() {
	cat <<'EOF'
spawn — open a tmux window running an agent CLI, seeded with a prompt
daryl — the same, in the current pane

Usage:
  spawn <agent> [options] [prompt words...]
  spawn [options] prompt words...     (agent defaults to claude)
  daryl [agent] [options] [prompt words...]

Agents:
  claude   Claude Code through pai (model switched with /model)
  codex    OpenAI Codex CLI
  gemini   Google Gemini CLI
  goose    Goose (needs a provider: goose configure)
  hermes   Hermes agent (any provider it has credentials for)

Options (before the prompt):
  -m <model>      model to use
  -p <provider>   provider, goose and hermes only
  -b <file>       hand over a brief file instead of a prompt
  -r [<id>]       resume that Claude session; no ID opens the picker (daryl only)
  -n <name>       tmux window name (default <agent>-HHMMSS; spawn only)
  -d              stay where you are, do not switch to the window (spawn only)
  -h, --help      this help (also: spawn help, spawn <agent> help)

Examples:
  spawn codex fix the failing test in this repo
  spawn claude -m opus -b ~/notes/brief.md
  spawn -r <session-id> address the review comments
  daryl Review https://forge.example/owner/repo/pulls/1
  daryl -r <session-id>               (resume here)
  daryl -r                            (pick a session to resume)
  daryl                               (plain Daryl session)

spawn runs inside tmux; the window starts in the current directory.
EOF
}

# A bare daryl is a plain session, as before.
if [ "$self" = daryl ] && [ $# -eq 0 ]; then
	exec pai
fi

# A lone "help" word is help; "help me with X" stays a prompt.
case "$#:${1:-}" in
0: | *:-h | *:--help | 1:help)
	usage
	exit 0
	;;
esac

agent=claude
case "$1" in
claude | codex | gemini | goose | hermes)
	agent=$1
	shift
	;;
esac
if [ "${1:-}" = --help ] || [ "$#:${1:-}" = 1:help ]; then
	usage
	exit 0
fi

model='' provider='' brief='' name='' detach='' resume='' pick=''
# Leading ':' lets -r go without an ID: a bare -r opens Claude's session picker.
while getopts :m:p:b:n:r:dh opt; do
	case $opt in
	m) model=$OPTARG ;;
	p) provider=$OPTARG ;;
	b) brief=$OPTARG ;;
	n) name=$OPTARG ;;
	r)
		case $OPTARG in
		-*)
			pick=1
			OPTIND=$((OPTIND - 1))
			;;
		*) resume=$OPTARG ;;
		esac
		;;
	d) detach=1 ;;
	h)
		usage
		exit 0
		;;
	:)
		if [ "$OPTARG" = r ]; then
			pick=1
		else
			echo "$self: option requires an argument -- $OPTARG" >&2
			usage >&2
			exit 2
		fi
		;;
	*)
		echo "$self: illegal option -- $OPTARG" >&2
		usage >&2
		exit 2
		;;
	esac
done
shift $((OPTIND - 1))
prompt="$*"

if [ "$self" = daryl ]; then
	if [ -n "$name" ] || [ -n "$detach" ]; then
		echo "daryl: -n and -d only apply to spawn" >&2
		exit 2
	fi
	if [ -n "$pick" ]; then
		if [ "$agent" != claude ] || [ -n "$prompt$brief" ]; then
			echo "daryl: -r without an ID takes no agent, prompt or brief" >&2
			exit 2
		fi
		if [ -n "$model" ]; then
			ANTHROPIC_MODEL=$model exec pai -r
		fi
		exec pai -r
	fi
	exec bun "$tool" --here --agent "$agent" \
		${model:+--model "$model"} ${provider:+--provider "$provider"} \
		${resume:+--resume "$resume"} ${brief:+--brief "$brief"} \
		${prompt:+--prompt "$prompt"}
fi

if [ -n "$pick" ]; then
	echo "spawn: -r needs a session ID (the picker is daryl -r)" >&2
	exit 2
fi
[ -n "$name" ] || name="$agent-$(date +%H%M%S)"
out=$(bun "$tool" --name "$name" --agent "$agent" --cwd "$PWD" --no-wait \
	${model:+--model "$model"} ${provider:+--provider "$provider"} \
	${resume:+--resume "$resume"} ${brief:+--brief "$brief"} \
	${prompt:+--prompt "$prompt"})
target=$(printf '%s\n' "$out" | sed -n '1s/ .*//p')
echo "$target ($name)"

if [ -z "$detach" ] && [ -n "${TMUX:-}" ]; then
	tmux switch-client -t "$target"
fi
