#!/usr/bin/env bash
set -euo pipefail

# systemd user services have minimal PATH; chezmoi (linuxbrew) needs explicit reach.
export PATH="/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:$HOME/.local/bin:$PATH"

REPOS=(
	"$HOME/.claude"
	"$HOME/.local/share/chezmoi"
)

TG_ENV="$HOME/.env"
CHAT_ID="-1003961816258"

# Telegram notifications are optional — only load the token if ~/.env exists
# AND defines TELEGRAM_BOT_TOKEN. Hosts without the env file (or without the
# token) still get a working sync; they just don't get notifications.
BOT_TOKEN=""
if [ -f "$TG_ENV" ]; then
	BOT_TOKEN=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$TG_ENV" | cut -d= -f2- || true)
fi

tg_notify() {
	[ -z "$BOT_TOKEN" ] && return 0
	curl -s "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
		-d "chat_id=${CHAT_ID}" \
		--data-urlencode "text=$1" >/dev/null 2>&1 || true
}

# Age floor for calling a lock abandoned. Real git operations on these repos
# finish in seconds, so an empty lock this old with no holder is a corpse.
STALE_LOCK_MIN_AGE=900

# Removing a lock a live git still holds corrupts the index, so this clears one
# only when it is provably nobody's. Anything short of that is left for a human;
# the `git add` below then fails as it already did.
# Returns 0 when a lock was removed, 1 when one was left alone.
clear_stale_index_lock() {
	local repo="$1" name="$2"
	local lock="$repo/.git/index.lock"

	[ -e "$lock" ] || return 1

	# A symlink here would redirect the rm out of the repo entirely.
	if [ -L "$lock" ] || [ ! -f "$lock" ]; then
		tg_notify "⚠️ pai-git-sync[$name]: index.lock is not a regular file — left alone"
		return 1
	fi

	# Non-empty means git wrote index content into it: live, or a partial write.
	if [ -s "$lock" ]; then
		tg_notify "⚠️ pai-git-sync[$name]: index.lock is non-empty — left alone"
		return 1
	fi

	local mtime now age
	mtime=$(stat -c %Y "$lock" 2>/dev/null) || return 1
	now=$(date +%s)
	age=$((now - mtime))
	[ "$age" -ge "$STALE_LOCK_MIN_AGE" ] || return 1

	# No holder is the load-bearing check, so a missing fuser fails closed.
	if ! command -v fuser >/dev/null 2>&1; then
		tg_notify "⚠️ pai-git-sync[$name]: fuser missing, cannot clear index.lock"
		return 1
	fi
	if fuser "$lock" >/dev/null 2>&1; then
		return 1
	fi

	# Closes the window between the age check and the rm.
	[ "$(stat -c %Y "$lock" 2>/dev/null)" = "$mtime" ] || return 1

	rm -f "$lock" || return 1
	echo "pai-git-sync[$name]: removed stale index.lock (empty, unheld, ${age}s old)"
	tg_notify "🧹 pai-git-sync[$name]: cleared stale index.lock (${age}s old, no holder)"
}

sync_repo() {
	local repo="$1"
	local name
	name=$(basename "$repo")
	cd "$repo" || {
		tg_notify "⚠️ pai-git-sync[$name]: cd failed"
		return 1
	}

	# Self-install the shell-lint gate. This script is the unattended committer,
	# so the guard has to be wired wherever the timer runs rather than wherever
	# someone remembered to set it. core.hooksPath is per-repo and lives in
	# untracked .git/config, so this is the only place it can land as code.
	local hooks_dir="$HOME/.config/git/hooks"
	if [ -x "$hooks_dir/pre-commit" ] &&
		[ "$(git config --get core.hooksPath || true)" != "$hooks_dir" ]; then
		# Non-fatal: an unset lint gate degrades commits, it doesn't make the sync wrong.
		if ! git config core.hooksPath "$hooks_dir"; then
			tg_notify "⚠️ pai-git-sync[$name]: could not set core.hooksPath (lint gate off)"
		fi
	fi

	if ! git fetch 2>&1; then
		tg_notify "⚠️ pai-git-sync[$name]: fetch failed (SSH key unavailable?)"
		return 1
	fi

	# A crashed git leaves index.lock behind and every later add fails until a
	# human clears it — three hours of dead syncs on 2026-09-03.
	clear_stale_index_lock "$repo" "$name" || true

	# Unguarded, a partial add stages nothing and the rest of the function no-ops
	# to a false success.
	if ! git add -A; then
		tg_notify "⚠️ pai-git-sync[$name]: git add failed"
		return 1
	fi

	if ! git diff --cached --quiet; then
		# Unattended auto-commits skip GPG signing: pinentry/YubiKey is unreachable
		# from a headless timer unit, so signing fails on cache-cold runs.
		if ! git commit --no-gpg-sign -m "auto: timed sync $(date '+%Y-%m-%d %H:%M')"; then
			tg_notify "⚠️ pai-git-sync[$name]: commit failed (shell lint gate?)"
			return 1
		fi
	fi

	if ! git rebase origin/main; then
		git rebase --abort 2>/dev/null || true
		tg_notify "⚠️ pai-git-sync[$name]: rebase conflict — resolve manually"
		return 1
	fi

	if ! git push; then
		tg_notify "⚠️ pai-git-sync[$name]: push failed"
		return 1
	fi

	# Post-sync hook for chezmoi: source commits don't render to target files until apply.
	# chezmoi apply is idempotent and overwrites drift — chezmoi treats source as canonical.
	if [ "$repo" = "$HOME/.local/share/chezmoi" ]; then
		# No -v: verbose apply renders the contents of files it changes, and the
		# source tree carries rbw-templated mail credentials (msmtprc, mbsyncrc,
		# imapnotify, aerc). Under a systemd unit that output lands in the journal.
		# Returns 2, not 1, so the caller can tell this apart from a git failure.
		if ! chezmoi apply 2>&1; then
			tg_notify "⚠️ pai-git-sync[$name]: chezmoi apply failed (git sync itself was OK)"
			return 2
		fi
	fi
}

# Sourced by the test suite: define the functions, sync nothing.
if [ "${PAI_GIT_SYNC_SOURCED:-0}" = "1" ]; then
	return 0
fi

git_failed=""
# Three states: a git-stage failure skips the hook entirely, and "did not run"
# must not read as "ran clean".
hook_state="not-run"

for repo in "${REPOS[@]}"; do
	repo_name=$(basename "$repo")
	if [ ! -d "$repo/.git" ]; then
		tg_notify "⚠️ pai-git-sync: $repo missing .git/"
		git_failed="${git_failed}${repo_name} "
		continue
	fi
	# The `||` disarms errexit inside sync_repo, so commands there check their own
	# status. The subshell only contains sync_repo's `cd` — keep it.
	rc=0
	(sync_repo "$repo") || rc=$?
	case "$rc" in
	0)
		if [ "$repo" = "$HOME/.local/share/chezmoi" ]; then
			hook_state="ok"
		fi
		;;
	2)
		hook_state="FAILED"
		;;
	*)
		git_failed="${git_failed}${repo_name} "
		;;
	esac
done

# Emitted on success too, so the journal states the outcome rather than implying it.
if [ -n "$git_failed" ]; then
	echo "pai-git-sync: git=FAILED (${git_failed% })"
else
	echo "pai-git-sync: git=ok"
fi
echo "pai-git-sync: post-sync-hook=$hook_state"

if [ -n "$git_failed" ] || [ "$hook_state" = "FAILED" ]; then
	exit 1
fi
exit 0
