#!/bin/sh
# hermes-daryl — launch a briefed Daryl session on the Hermes runtime.
#
# Usage:
#   hermes-daryl [dir]                      # session in dir (default: cwd)
#   hermes-daryl [dir] <provider> [model]   # pick provider/model
#
# Identity comes from ~/.hermes/SOUL.md, generated by
# `bun ~/.claude/PAI/TOOLS/RenderBrief.ts --profile hermes`. Regenerating it
# needs a gateway restart AND `/reset` in a live chat: disk, process and
# session are three separate staleness layers.
#
# No --yolo, mirroring goose-daryl's GOOSE_MODE=approve default. Hermes runs
# no PAI guard plugin at all, so the interactive approval prompt is the only
# backstop there is.
set -eu

dir="${1:-$PWD}"
provider="${2:-}"
model="${3:-}"

if [ ! -d "$dir" ]; then
  echo "hermes-daryl: not a directory: $dir" >&2
  exit 1
fi

# --in with --no-restore-cwd is load-bearing: hermes restores the PREVIOUS
# session's directory by default, so plain `cd "$dir"` is silently ignored.
set -- --in "$dir" --no-restore-cwd

if [ -n "$provider" ]; then
  # hermes refuses --provider without --model ("Pass both explicitly, or
  # neither"), so fail here rather than emitting a confusing runtime error.
  if [ -z "$model" ]; then
    echo "hermes-daryl: provider '$provider' also needs a model" >&2
    exit 2
  fi
  set -- "$@" --provider "$provider" --model "$model"
fi

exec hermes "$@"
