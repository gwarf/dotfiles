#!/bin/sh
# hermes-daryl — launch a briefed Daryl session on the Hermes runtime.
#
# Usage:
#   hermes-daryl [dir]                      # session in dir (default: cwd)
#   hermes-daryl [dir] <provider> [model]   # pick provider/model
#
# Identity comes from ~/.hermes/SOUL.md, generated by
# `bun ~/.claude/PAI/TOOLS/RenderBrief.ts --profile hermes`. Regenerating it
# needs a gateway restart AND `/reset` in a live chat: disk, process and
# session are three separate staleness layers.
#
# No --yolo, mirroring goose-daryl's GOOSE_MODE=approve default. The PAI guard
# plugin must be mounted (bun ~/.claude/PAI/HERMES/Mount.ts); this launcher
# refuses to start without it.
set -eu

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
if [ ! -f "$HERMES_HOME/plugins/lifeos/policy.json" ]; then
  echo "hermes-daryl: PAI guard not installed — run: bun ~/.claude/PAI/HERMES/Mount.ts" >&2
  exit 1
fi
# Hermes skips a plugin that fails to import (fail-open); prove it imports first.
"$HERMES_HOME/hermes-agent/venv/bin/python" -c \
  "import sys, json; sys.path.insert(0, '$HERMES_HOME/plugins'); import lifeos; assert json.load(open('$HERMES_HOME/plugins/lifeos/policy.json'))['denyRules']" \
  || { echo "hermes-daryl: PAI guard plugin does not import or policy unreadable — refusing to start" >&2; exit 1; }
grep -qE '^    - lifeos$' "$HERMES_HOME/config.yaml" \
  || { echo "hermes-daryl: lifeos not in plugins.enabled — run: bun ~/.claude/PAI/HERMES/Mount.ts" >&2; exit 1; }
# write_file/patch are hard-blocked outside these roots; the PAI tree stays read-only.
HERMES_WRITE_SAFE_ROOT="${HERMES_WORKSPACE:-$HOME/HermesWorkspace}:$HERMES_HOME"
export HERMES_HOME HERMES_WRITE_SAFE_ROOT

dir="${1:-$PWD}"
provider="${2:-}"
model="${3:-}"

if [ ! -d "$dir" ]; then
  echo "hermes-daryl: not a directory: $dir" >&2
  exit 1
fi

# --in with --no-restore-cwd is load-bearing: hermes restores the PREVIOUS
# session's directory by default, so plain `cd "$dir"` is silently ignored.
set -- --in "$dir" --no-restore-cwd

if [ -n "$provider" ]; then
  # hermes refuses --provider without --model ("Pass both explicitly, or
  # neither"), so fail here rather than emitting a confusing runtime error.
  if [ -z "$model" ]; then
    echo "hermes-daryl: provider '$provider' also needs a model" >&2
    exit 2
  fi
  set -- "$@" --provider "$provider" --model "$model"
fi

exec hermes "$@"
