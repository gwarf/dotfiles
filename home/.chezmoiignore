{{- if stat "/usr/share/omarchy" }}
# Omarchy-seeded config we have NOT taken ownership of; its copy wins here.
# Taking ownership means customising the file and adding it, at which point it
# leaves this list for good - so this is a curated set, never regenerated by
# listing everything Omarchy provides.
# Gated on the directory, not the hostname, so other hosts keep these dotfiles.
# Never list .config, .local, .config/git or .config/systemd: skel has those
# directories too, and an entry here would ignore everything beneath them.
.config/alacritty/alacritty.toml
.config/chromium-flags.conf
.config/herdr/config.toml
.config/hypr/hyprland.lua
.config/kitty/kitty.conf
.config/starship.toml
# Omarchy owns the desktop stack. These configure waybar, wofi and hyprpaper,
# none of which Omarchy installs, and mocha.lua is loaded by a require() that
# only existed in the pre-Omarchy hyprland.lua.
# The directories too: once their files are ignored nothing managed remains
# under them, and leaving them managed makes apply prompt for a TTY it has
# none of when it runs from pai-git-sync.service.
.config/waybar
.config/wofi
.config/waybar/config.jsonc
.config/waybar/style.css
.config/waybar/mocha.css
.config/wofi/style.css
.config/hypr/hyprpaper.conf
.config/hypr/mocha.lua
# Colour schemes for the pre-Omarchy terminal configs. Omarchy's own
# alacritty.toml and kitty.conf import from its theme system under
# ~/.local/state/omarchy/current/theme, so nothing loads these.
.config/alacritty/tokyonight_day.toml
.config/alacritty/tokyonight_moon.toml
.config/alacritty/tokyonight_night.toml
.config/alacritty/tokyonight_storm.toml
.config/kitty/dracula.conf
.config/kitty/tokyonight_moon.conf
.config/kitty/tokyonight_storm.conf
# Omarchy owns nvim on this host, whole subtree. Safe as a directory entry
# because nothing under it should be managed here - unlike .config or .local,
# which hold managed files alongside the Omarchy-seeded ones.
.config/nvim
{{- end }}

{{- if not (stat "/usr/share/omarchy") }}
# .bashrc here is Omarchy's file plus a direnv hook, so it is meaningless off
# Omarchy and would clobber whatever bashrc the host already has.
.bashrc
# Omarchy's per-concern Hyprland files: the autostart hooks and the omarchy-*
# PATH shadows they enable, and the input overrides, which only get required
# from Omarchy's own hyprland.lua.
.config/hypr/autostart.lua
.config/hypr/input.lua
.local/bin/omarchy-overrides
{{- end }}
