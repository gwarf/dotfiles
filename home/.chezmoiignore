{{- if ne .chezmoi.hostname "torpedo" }}
# Only the credstore drop-in is torpedo-specific (TPM2+host sealed, and
# systemd-creds has no --user on assist). per-pair.conf must reach every host.
.config/systemd/user/vdirsyncer.service.d/torpedo-credstore.conf
.config/rbw-perso
.config/systemd/user/input-leap-client.service
.config/kxkbrc
.config/brave-flags.conf
# Only torpedo's unattended mail and sync jobs read secrets through rbw.
.config/systemd/user/goimapnotify@.service.d
.config/systemd/user/mailsync.service.d
.config/systemd/user/pai-git-sync.service.d
.config/systemd/user/graphical-session.target.wants/goimapnotify@operas.service
# Call auto-recording is a torpedo meeting-desk job (KWin, CUDA transcription).
.config/systemd/user/meeting-autorec.service
.config/systemd/user/graphical-session.target.wants/meeting-autorec.service
{{- end }}
{{- if and (ne .chezmoi.hostname "torpedo") (ne .chezmoi.hostname "sikaru") }}
.config/powerdevilrc
# rbw-agent needs a desktop for pinentry; headless hosts have neither.
.config/systemd/user/rbw-agent.service
.config/systemd/user/graphical-session.target.wants/rbw-agent.service
{{- end }}
{{- if ne .chezmoi.osRelease.id "arch" }}
# Arch packages the fabric CLI as fabric-ai (extra/fabric is the Python SSH
# tool); other hosts install the upstream binary under its own name.
.local/bin/fabric
{{- end }}
{{- if not (stat "/usr/bin/httpx-toolkit") }}
# AUR httpx-bin ships ProjectDiscovery's httpx as httpx-toolkit (python-httpx
# owns the bare name); linked only where it exists so nothing dangles.
.local/bin/httpx
{{- end }}
{{- if ne .chezmoi.hostname "sikaru" }}
.config/InputLeap
.config/systemd/user/input-leap-server.service
# Brave Origin is sikaru's Interceptor browser; torpedo/assist launch theirs differently.
.config/systemd/user/brave-interceptor.service
.config/systemd/user/graphical-session.target.wants/brave-interceptor.service
# Hyprland's polkit agent; torpedo's KDE session brings its own.
.config/systemd/user/graphical-session.target.wants/hyprpolkitagent.service
{{- end }}
{{- if eq .chezmoi.hostname "assist" }}
# aerc resolves `rbw` at render time, and chezmoi apply runs unattended here
# (pai-git-sync.service) with no pinentry. Ignoring is not a delete — an
# already-rendered file stays put. Rest of the list: headless box.
# vdirsyncer left this list once its credentials moved to run-time fetch; its
# config froze here for 103 days precisely because it was on it.
.config/aerc
.config/alacritty
.config/backgrounds
.config/beets
.config/emails
.config/hypr
.config/kitty
.config/waybar
.config/rofi
.config/yay
.config/zellij
.config/systemd/user/pai-pulse.service
.local/bin/vaultpick
.msmtprc
bin/add_event
bin/autostart.sh
bin/browsh_serve.sh
bin/color-spaces.pl
bin/colors.py
bin/dual-screen
bin/gnomekeyring-helpers.py
bin/launch_bar
bin/lemonbar.sh
bin/mutt_bgrun
bin/nerd-fonts.sh
bin/setup_kinesis_keyboard
bin/start_zoom
bin/true-color.sh
{{- end }}
{{- if eq .chezmoi.hostname "delamain" }}
# Headless FreeBSD box without rbw: keep the mail/sync stack, whose
# credentials come from rbw at run time, from landing on a bare apply.
.config/aerc
.config/imapnotify
.config/rbw
.config/systemd/user/mailsync.service
.config/systemd/user/mailsync.timer
.config/systemd/user/mbsync.service
.config/systemd/user/mbsync.timer
.config/systemd/user/msmtp-runqueue.service
.config/systemd/user/msmtp-runqueue.timer
.config/systemd/user/pai-git-sync.service
.config/systemd/user/pai-git-sync.timer
.config/vdirsyncer
.local/bin/meeting-transcribe
.local/bin/msmtp-queue
.local/bin/msmtpq
.local/bin/pai-git-sync
.local/bin/pinentry-rbw
.local/bin/vaultpick
.mbsyncrc
.msmtprc
{{- end }}
